ifndef config
  config=debug
endif

ifndef verbose
  SILENT = @
endif

ifeq ($(config),debug)
  Glfw_config = debug
  QuestPoiEditor_config = debug
  QuestPoiCoreTests_config = debug
  QuestPoiDatabaseIntegrationTests_config = debug

else ifeq ($(config),release)
  Glfw_config = release
  QuestPoiEditor_config = release
  QuestPoiCoreTests_config = release
  QuestPoiDatabaseIntegrationTests_config = release

else
  $(error "invalid configuration $(config)")
endif

PROJECTS := Glfw QuestPoiEditor QuestPoiCoreTests QuestPoiDatabaseIntegrationTests

.PHONY: all clean help $(PROJECTS) 

all: $(PROJECTS)

Glfw:
ifneq (,$(Glfw_config))
	@echo "==== Building Glfw ($(Glfw_config)) ===="
	@${MAKE} --no-print-directory -C . -f Glfw.make config=$(Glfw_config)
endif

QuestPoiEditor: Glfw
ifneq (,$(QuestPoiEditor_config))
	@echo "==== Building QuestPoiEditor ($(QuestPoiEditor_config)) ===="
	@${MAKE} --no-print-directory -C . -f QuestPoiEditor.make config=$(QuestPoiEditor_config)
endif

QuestPoiCoreTests:
ifneq (,$(QuestPoiCoreTests_config))
	@echo "==== Building QuestPoiCoreTests ($(QuestPoiCoreTests_config)) ===="
	@${MAKE} --no-print-directory -C . -f QuestPoiCoreTests.make config=$(QuestPoiCoreTests_config)
endif

QuestPoiDatabaseIntegrationTests:
ifneq (,$(QuestPoiDatabaseIntegrationTests_config))
	@echo "==== Building QuestPoiDatabaseIntegrationTests ($(QuestPoiDatabaseIntegrationTests_config)) ===="
	@${MAKE} --no-print-directory -C . -f QuestPoiDatabaseIntegrationTests.make config=$(QuestPoiDatabaseIntegrationTests_config)
endif

clean:
	@${MAKE} --no-print-directory -C . -f Glfw.make clean
	@${MAKE} --no-print-directory -C . -f QuestPoiEditor.make clean
	@${MAKE} --no-print-directory -C . -f QuestPoiCoreTests.make clean
	@${MAKE} --no-print-directory -C . -f QuestPoiDatabaseIntegrationTests.make clean

help:
